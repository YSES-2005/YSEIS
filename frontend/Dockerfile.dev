FROM node:20-alpine

WORKDIR /usr/src/app

# Ensure non-interactive pnpm behavior
ENV CI=true

# Use pnpm lockfile when present
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY shared /usr/src/shared

RUN corepack enable && corepack prepare pnpm@latest --activate && \
    (cd /usr/src/shared && pnpm install --frozen-lockfile && pnpm build) && \
    pnpm install --frozen-lockfile

COPY frontend/ .

EXPOSE 5173

ENV NODE_ENV=development
CMD ["pnpm", "run", "dev"]
